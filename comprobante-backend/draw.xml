<mxfile host="app.diagrams.net">
  <diagram name="DER Fraude">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ANALISIS -->
        <mxCell id="analisis" value="ANALISIS&#xa;----------------&#xa;PK id INT&#xa;fecha DATETIME&#xa;nombre_archivo VARCHAR&#xa;texto_extraido TEXT&#xa;similitud_imagen FLOAT&#xa;indice_sospecha FLOAT&#xa;resultado VARCHAR"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="50" width="260" height="160" as="geometry"/>
        </mxCell>

        <!-- INDICADOR -->
        <mxCell id="indicador" value="INDICADOR&#xa;----------------&#xa;PK id INT&#xa;FK analisis_id INT&#xa;tipo VARCHAR&#xa;descripcion VARCHAR&#xa;valor VARCHAR"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="260" height="140" as="geometry"/>
        </mxCell>

        <!-- EXPORTACION -->
        <mxCell id="exportacion" value="EXPORTACION&#xa;----------------&#xa;PK id INT&#xa;FK analisis_id INT&#xa;tipo (PDF/CSV)&#xa;fecha DATETIME"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;"
          vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="260" height="120" as="geometry"/>
        </mxCell>

        <!-- CONFIGURACION -->
        <mxCell id="config" value="CONFIGURACION&#xa;----------------&#xa;PK id INT&#xa;clave VARCHAR&#xa;valor VARCHAR&#xa;descripcion VARCHAR"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;"
          vertex="1" parent="1">
          <mxGeometry x="800" y="80" width="260" height="140" as="geometry"/>
        </mxCell>

        <!-- RELACIONES -->
        
        <!-- Analisis -> Indicador -->
        <mxCell id="rel1" style="endArrow=block;html=1;strokeWidth=2;"
          edge="1" parent="1" source="analisis" target="indicador">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Analisis -> Exportacion -->
        <mxCell id="rel2" style="endArrow=block;html=1;strokeWidth=2;"
          edge="1" parent="1" source="analisis" target="exportacion">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
